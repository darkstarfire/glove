#!/bin/sh
# Glove OS removido: os arquivos do Debian voltam para o lugar.
set -e
voltar() {
    if dpkg-divert --listpackage "$1" 2>/dev/null | grep -qx glove-os; then
        rm -f "$1"
        dpkg-divert --package glove-os --remove --rename --divert "$1.debian" "$1" >/dev/null
    fi
}
case "$1" in
    remove|purge|abort-install)
        voltar /usr/lib/os-release
        voltar /etc/issue
        voltar /etc/issue.net
        ;;
esac
exit 0
