#!/bin/sh
# Glove OS removed: Debian's files go back to their place.
set -e
restore() {
    if dpkg-divert --listpackage "$1" 2>/dev/null | grep -qx glove-os; then
        rm -f "$1"
        dpkg-divert --package glove-os --remove --rename --divert "$1.debian" "$1" >/dev/null
    fi
}
# The boot screen (Plymouth) goes back to the theme from before, if it is still Glove's.
boot_screen() {
    done_file=/var/lib/glove-os/plymouth
    [ -e "$done_file" ] || return 0
    if command -v plymouth-set-default-theme >/dev/null 2>&1 && [ "$(plymouth-set-default-theme 2>/dev/null)" = glove ]; then
        before=$(cat "$done_file" 2>/dev/null || true)
        if [ -n "$before" ] && [ "$before" != glove ] && [ -d "/usr/share/plymouth/themes/$before" ]; then
            plymouth-set-default-theme "$before" || true
        else
            plymouth-set-default-theme -r || true
        fi
        command -v update-initramfs >/dev/null 2>&1 && update-initramfs -u || true
    fi
    rm -f "$done_file"
    rmdir /var/lib/glove-os 2>/dev/null || true
}
case "$1" in
    remove|purge|abort-install)
        restore /usr/lib/os-release
        restore /etc/issue
        restore /etc/issue.net
        boot_screen
        ;;
esac
exit 0
