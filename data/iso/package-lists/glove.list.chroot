# Pacotes do Glove ao vivo (Debian). O pacote do Glove em si vai à parte
# (config/packages.chroot) e traz as dependências dele.

# Base
systemd-sysv
udev
dbus
libpam-systemd
user-setup
sudo
iproute2
pciutils
usbutils
xdg-desktop-portal
locales
console-setup
keyboard-configuration
dbus-user-session
systemd-timesyncd
bash-completion
nano
less
curl
ca-certificates

# Tela de início e de desligamento do sistema (o tema do Glove vem no pacote glove-os)
plymouth
plymouth-label

# Senha do sistema (o agente do Glove atende o polkit) e o serviço de discos (Discos)
polkitd
udisks2
# Discos: pendrive do Windows (dividir o install.wim) e formatos de disco
wimtools
exfatprogs
ntfs-3g
btrfs-progs

# Rede
network-manager
wpasupplicant
iw
rfkill

# Firmware só de computadores de uso diário (desktops e notebooks): vídeo, Wi-Fi,
# Bluetooth e som. Os de servidor (placas de rede de datacenter: Netronome, Cavium,
# QLogic, Myricom, Broadcom NetXtreme…) ficam de fora, uns 160 MB a menos; quem
# precisar instala depois (sudo apt install firmware-netronome…).
firmware-linux-free
firmware-misc-nonfree
firmware-amd-graphics
firmware-nvidia-graphics
firmware-intel-graphics
firmware-intel-misc
firmware-intel-sound
firmware-sof-signed
firmware-cirrus
firmware-iwlwifi
firmware-realtek
firmware-atheros
firmware-ath9k-htc
firmware-carl9170
firmware-mediatek
firmware-brcm80211
firmware-libertas
firmware-zd1211
amd64-microcode
intel-microcode

# Som e o que o Glove recomenda
pipewire
pipewire-pulse
pipewire-bin
wireplumber
xwayland
mpv
ffmpeg
poppler-utils
xdg-utils
desktop-file-utils
libnotify-bin
fonts-dejavu
fonts-noto-core
fonts-noto-color-emoji

# Navegador
firefox-esr
firefox-esr-l10n-pt-br

# Apps
flatpak

# Instalador (partições, cópia do sistema e o carregador de boot)
fdisk
dosfstools
e2fsprogs
squashfs-tools
efibootmgr
grub-efi-amd64-bin
grub-pc-bin
grub2-common
os-prober
fastfetch
