#!/bin/sh
# Ajustes do Glove OS ao vivo (roda dentro da imagem, durante a montagem da ISO).
# O instalador desfaz o que é só do sistema ao vivo ao copiar para o disco.
set -e

# Tela de login do Glove como a principal, entrando sozinha com o usuário ao vivo.
# O pacote greetd ativa o greetd.service dele (o login de texto "agreety") como
# display-manager; sem o --force, o enable do glove-login falha nesse apelido.
for dm in greetd gdm3 lightdm sddm; do systemctl disable "$dm.service" 2>/dev/null || true; done
systemctl enable --force glove-login.service
[ "$(readlink -f /etc/systemd/system/display-manager.service)" = /usr/lib/systemd/system/glove-login.service ] || {
    echo "glove: a tela de login do Glove não ficou como display-manager" >&2
    exit 1
}
# Sem os atalhos dos apps, nada abre (nem o instalador).
[ -x /usr/bin/glove-installer ] || { echo "glove: falta /usr/bin/glove-installer no pacote" >&2; exit 1; }
mkdir -p /etc/glove
echo glove > /etc/glove/autologin

# Tela de início do sistema (Plymouth) com o tema do Glove. O initramfs é refeito pelo
# live-build logo depois dos ganchos; o instalador refaz o do sistema instalado.
/usr/share/glove-os/boot-screen --no-initramfs || true

# Idiomas que o instalador oferece, já prontos.
for l in pt_BR en_US en_GB pt_PT es_ES fr_FR de_DE it_IT; do
    sed -i "s/^# *$l.UTF-8 UTF-8/$l.UTF-8 UTF-8/" /etc/locale.gen
done
locale-gen

# O instalador abre sozinho ao entrar e fica na Busca Rápida.
mkdir -p /etc/xdg/autostart /usr/share/applications
cat > /etc/xdg/autostart/glove-installer.desktop <<FIM
[Desktop Entry]
Type=Application
Name=Instalar o Glove OS
Name[en]=Install Glove OS
Exec=glove-installer
OnlyShowIn=Glove;
FIM
cat > /usr/share/applications/glove-installer.desktop <<FIM
[Desktop Entry]
Type=Application
Name=Instalar o Glove OS
Name[en]=Install Glove OS
Exec=glove-installer
Icon=drive-harddisk
Categories=System;
FIM

# Sem o assistente de boas-vindas no sistema ao vivo (o instalador pergunta tudo).
mkdir -p /etc/skel/.config/glove
# Ao vivo, a tela que apaga ou o repouso não pedem senha ao voltar (a conta ao vivo
# tem a senha "live", que ninguém sabe). O instalador apaga este arquivo: o sistema
# instalado pede a senha, como deve.
printf 'welcome_done = true\n\n[energy]\nrequire_password = false\n' > /etc/skel/.config/glove/config.toml

# Flathub disponível para a Central de Apps.
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true
