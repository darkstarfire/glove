#!/bin/sh
# Sessão do Glove: é o que a tela de login (GDM, LightDM, greetd) executa ao escolher
# "Glove". Prepara o ambiente de uma sessão Wayland e inicia o compositor direto na tela.

# Sem barramento de sessão (algumas telas de login não abrem um): roda dentro de um.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null; then
    exec dbus-run-session -- "$(readlink -f "$0")" "$@"
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Glove
export XDG_SESSION_DESKTOP=glove
export GLOVE_BACKEND=drm
# Apps de fora que sabem usar Wayland passam a usá-lo.
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland
export SDL_VIDEODRIVER=wayland
export ELECTRON_OZONE_PLATFORM_HINT=auto
export _JAVA_AWT_WM_NONREPARENTING=1

# O compositor: ao lado deste script (instalado) ou o do projeto (desenvolvimento).
dir="$(dirname "$(readlink -f "$0")")"
glove=glove
for c in "$dir/glove" "$dir/../target/release/glove"; do
    if [ -x "$c" ]; then
        glove="$c"
        break
    fi
done

# Log da sessão, para quando algo der errado (na tela não há terminal).
log="${XDG_STATE_HOME:-$HOME/.local/state}/glove/sessao.log"
mkdir -p "$(dirname "$log")"
[ -f "$log" ] && mv -f "$log" "$log.anterior"

# Os serviços do usuário (portais, etc.) passam a conhecer esta sessão Wayland.
if command -v systemctl >/dev/null; then
    systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null
fi

exec "$glove" --sessao >"$log" 2>&1
