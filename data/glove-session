#!/bin/sh
# Glove session: what the login screen (GDM, LightDM, greetd) runs when "Glove" is
# chosen. Prepares the environment of a Wayland session and starts the compositor on the display.

# No session bus (some login screens do not open one): run inside one.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null; then
    exec dbus-run-session -- "$(readlink -f "$0")" "$@"
fi

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Glove
export XDG_SESSION_DESKTOP=glove
export GLOVE_BACKEND=drm
# Outside apps that can use Wayland start using it.
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM='wayland;xcb'
export GDK_BACKEND=wayland,x11
export SDL_VIDEODRIVER=wayland,x11
export ELECTRON_OZONE_PLATFORM_HINT=auto
export _JAVA_AWT_WM_NONREPARENTING=1
# Open/Save dialogs of GTK apps (Firefox…) go through the portal: they become the Glove one.
export GTK_USE_PORTAL=1

# Language and formats chosen in the International pane (LANG and LC_*).
env_file="${XDG_CONFIG_HOME:-$HOME/.config}/glove/ambiente.conf"
if [ -f "$env_file" ]; then
    set -a
    . "$env_file"
    set +a
fi

# The compositor: next to this script (installed) or the project's own (development).
dir="$(dirname "$(readlink -f "$0")")"
glove=glove
for c in "$dir/glove" "$dir/../target/release/glove"; do
    if [ -x "$c" ]; then
        glove="$c"
        break
    fi
done

# Session log, for when something goes wrong (there is no terminal on screen).
log="${XDG_STATE_HOME:-$HOME/.local/state}/glove/sessao.log"
mkdir -p "$(dirname "$log")"
[ -f "$log" ] && mv -f "$log" "$log.anterior"

# The user services (portals, etc.) learn about this Wayland session.
if command -v systemctl >/dev/null; then
    systemctl --user import-environment XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null
fi

exec "$glove" --sessao >"$log" 2>&1
