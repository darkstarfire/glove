# Bateria do Chromebook lida direto do EC (glove-bateria), para quando o firmware diz
# ao Linux "bateria ausente". Só roda em Chromebooks (onde existe o EC do ChromeOS);
# nos outros computadores, o systemd pula o serviço. Se o cros-ec-battery do
# chromebook-linux-fixes já estiver instalado, vale o dele.
[Unit]
Description=Bateria do Chromebook lida direto do EC (Glove)
ConditionPathExists=/sys/class/chromeos/cros_ec
ConditionPathExists=!/etc/systemd/system/multi-user.target.wants/cros-ec-battery.service
After=systemd-modules-load.service

[Service]
ExecStart=@PREFIXO@/bin/glove-bateria --daemon
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
