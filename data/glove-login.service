# Glove login screen: greetd with the Glove configuration (the system's greetd
# one is left alone). To make it the main login screen:
#   sudo systemctl enable --force glove-login
# To go back to the previous one (e.g. GDM):
#   sudo systemctl enable --force gdm
[Unit]
Description=Glove login screen (greetd)
After=systemd-user-sessions.service plymouth-quit-wait.service
After=getty@tty7.service
Conflicts=getty@tty7.service

[Service]
Type=simple
ExecStart=@PREFIXO@/lib/glove/glove-login-greetd
IgnoreSIGPIPE=no
SendSIGHUP=yes
TimeoutStopSec=30s
KeyringMode=shared
Restart=always
RestartSec=1
StartLimitBurst=5
StartLimitInterval=30

[Install]
Alias=display-manager.service
